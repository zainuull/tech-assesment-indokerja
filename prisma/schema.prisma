generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JOB_SEEKER
  COMPANY
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobState {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  email          String               @unique
  passwordHash   String
  role           Role
  createdAt      DateTime             @default(now())
  jobs           Job[]
  applications   Application[]
  statusChanges  ApplicationHistory[]
  sessions       AuthSession[]
}

model Job {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  company      User          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title        String
  description  String
  location     String
  salaryMin    Int
  salaryMax    Int
  jobType      JobType
  state        JobState      @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@index([companyId, createdAt])
  @@index([createdAt])
  @@index([state, createdAt])
}

model Application {
  id        String               @id @default(uuid()) @db.Uuid
  jobId     String               @db.Uuid
  job       Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  seekerId  String               @db.Uuid
  seeker    User                 @relation(fields: [seekerId], references: [id], onDelete: Restrict)
  status    ApplicationStatus    @default(APPLIED)
  appliedAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  history   ApplicationHistory[]
  notes     CandidateNote[]

  @@unique([jobId, seekerId])
  @@index([seekerId, appliedAt])
  @@index([jobId, appliedAt(sort: Desc), id])
}

model ApplicationHistory {
  id            Int                @id @default(autoincrement())
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedBy     String             @db.Uuid
  actor         User               @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  changedAt     DateTime           @default(now())

  @@index([applicationId, id])
}

model CandidateNote {
  id            Int         @id @default(autoincrement())
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId, id])
}

model AuthSession {
  tokenHash String   @id @db.Char(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId])
}
